{
  "name": "@nest-openapi/mcp",
  "version": "0.1.0",
  "description": "Spec-driven MCP server for exposing OpenAPI operations as tools",
  "sideEffects": false,
  "keywords": [
    "nest",
    "nestjs",
    "openapi",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "homepage": "https://nest-openapi.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ts-oas/nest-openapi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Alireza Malek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ts-oas/nest-openapi/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target node20 --outDir dist --clean --external zod --external @modelcontextprotocol/sdk --external @nestjs/common --external @nestjs/core",
    "test": "jest",
    "prepack": "node -e \"const fs=require('fs');const path=require('path');fs.copyFileSync(path.resolve(__dirname,'..','..','README.md'), path.resolve(__dirname,'README.md'));\"",
    "postpack": "node -e \"const fs=require('fs');const path=require('path');try{fs.unlinkSync(path.resolve(__dirname,'README.md'))}catch(_){}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nest-openapi/runtime": "^0.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nest-openapi/runtime": "workspace:^",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.0.0",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@modelcontextprotocol|zod)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@nest-openapi/runtime$": "<rootDir>/../runtime/src/index.ts"
    }
  }
}
